        android:textSize="18sp" />
    <Button
        android:id="@+id/button10"
        android:layout_gravity="fill"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:background="#EEF2F0"
        android:textSize="18sp"
        android:layout_margin="5sp"
        android:text="0A3" />
    <Button
        android:id="@+id/button11"
        android:layout_gravity="fill"
        android:layout_columnWeight="1"
